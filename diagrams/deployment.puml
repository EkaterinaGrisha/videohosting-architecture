@startuml deployment
title Видеохостинг «Ракурс»: диаграмма развёртывания

skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam nodesep 50
skinparam ranksep 70

node "Устройство зрителя" <<device>> as viewer {
  artifact "веб-приложение\n(браузер)" as a_web
  artifact "приложение\niOS / Android" as a_mobile
  artifact "приложение\nSmart TV" as a_tv
}

node "Компьютер автора" <<device>> as author {
  artifact "студия автора\n(браузер)" as a_studio
}

node "Узел CDN: 40 площадок,\n128 серверов по 100 Гбит/с\n(сети операторов, точки обмена трафиком)" <<device>> as edge {
  node "nginx" <<executionEnvironment>> as edge_nginx {
    artifact "кэш сегментов HLS/DASH,\nобложек и коротких видео" as a_cache
  }
}

node "ЦОД-1, Москва" as dc1 {
  node "Балансировщики L4/L7" <<device>> as lb1
  node "Origin shield\n(кэш второго уровня)" <<device>> as shield1

  node "Кластер Kubernetes" <<executionEnvironment>> as k8s1 {
    artifact "api-gateway" as a_gw
    artifact "accounts:\nauth, notifications" as a_accounts
    artifact "content:\ncatalog, upload,\nmoderation, rights" as a_content
    artifact "viewing:\nplayback, search,\nfeed, ads" as a_viewing
    artifact "social:\nreactions, comments" as a_social
    artifact "money:\nstats, goods,\npremium" as a_money
  }

  node "Изолированный сегмент выплат" <<device>> as pay1 {
    artifact "payouts" as a_payouts
    database "PostgreSQL\nвыплат" as pgpay1
  }

  node "GPU-серверы транскодирования, 70 шт." <<device>> as gpu1 {
    artifact "transcoder-worker" as a_transcoder
  }

  node "GPU-серверы рекомендаций" <<device>> as rec1 {
    artifact "recommender-inference" as a_rec
  }

  node "Серверы СУБД" <<device>> as db1 {
    database "PostgreSQL\n(ведущий)" as pg1
    database "Redis" as redis1
  }

  node "Аналитические серверы" <<device>> as an1 {
    database "ClickHouse" as ch1
    database "OpenSearch" as os1
  }

  node "Kafka" <<device>> as kafka1
  node "Ceph (S3),\n≈ 230 ПБ сырой ёмкости" <<device>> as ceph1
}

node "ЦОД-2, Москва\n(состав как в ЦОД-1)" as dc2 {
  node "Кластер Kubernetes" <<executionEnvironment>> as k8s2
  database "PostgreSQL\n(синхронная реплика)" as pg2
  node "Kafka" <<device>> as kafka2
  node "Ceph (S3)" <<device>> as ceph2
}

cloud "Внешние системы" as ext {
  node "SMS-шлюз" as sms
  node "Банк" as bank
  node "Эквайринг" as acq
  node "Рекламные системы" as adnet
  node "Оператор\nрекламных данных" as ord
  node "Маркетплейсы" as mp
}

a_web -[hidden]right- a_mobile
a_mobile -[hidden]right- a_tv
a_gw -[hidden]right- a_accounts
a_accounts -[hidden]right- a_content
a_content -[hidden]right- a_viewing
a_viewing -[hidden]right- a_social
a_social -[hidden]right- a_money
sms -[hidden]right- bank
bank -[hidden]right- acq
acq -[hidden]right- adnet
adnet -[hidden]right- ord
ord -[hidden]right- mp

viewer -- edge : HTTPS\nHLS/DASH
viewer -- lb1 : HTTPS\nREST
author -- lb1 : HTTPS\nREST, tus
edge -- shield1 : HTTPS,\nпромахи кэша
shield1 -- ceph1 : S3 API
lb1 -- k8s1 : HTTP/2
k8s1 -- db1 : TCP
k8s1 -- an1 : TCP
k8s1 -- kafka1 : Kafka
k8s1 -- ceph1 : S3 API
k8s1 -- rec1 : gRPC
k8s1 -- pay1 : mTLS
gpu1 -- ceph1 : S3 API
gpu1 -- kafka1 : Kafka
k8s1 -- ext : HTTPS
pay1 -- bank : HTTPS
pg1 -- pg2 : синхронная\nрепликация
ceph1 -- ceph2 : репликация\nобъектов
kafka1 -- kafka2 : MirrorMaker 2

note bottom of dc2
  Оба ЦОД обслуживают запросы одновременно.
  GeoDNS распределяет зрителей между ними,
  при отказе одного ЦОД весь трафик уходит
  в другой. Персональные данные хранятся
  только в этих двух ЦОД.
end note
@enduml
