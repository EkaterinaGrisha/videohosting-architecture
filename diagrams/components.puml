@startuml components
title Видеохостинг «Ракурс»: диаграмма компонентов

skinparam componentStyle uml2
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam packageStyle rectangle
skinparam linetype polyline
skinparam nodesep 70
skinparam ranksep 60

package "Клиенты" as clients {
  [Веб: просмотр\nи студия автора] as web
  [Приложения\niOS и Android] as mobile
  [Приложение\nSmart TV] as tv
  [Рабочее место\nмодератора] as modui
}

() "REST API" as api
() "HLS / DASH" as hls
[API-шлюз] as gw
[CDN] as cdn
gw -up- api
cdn -up- hls
clients ..> api
clients ..> hls

package "Аккаунты" as p_accounts {
  component "Учётные записи" as auth {
    database "PostgreSQL" as auth_db
    database "Redis:\nсессии" as auth_cache
  }
  component "Уведомления" as notify
}

package "Контент" as p_content {
  [Загрузка\n(tus)] as upload
  [Обработка видео\n(GPU)] as transcode
  component "Каталог видео\nи каналов" as catalog {
    database "PostgreSQL" as catalog_db
  }
  component "Проверка прав\n(отпечатки)" as rights {
    database "Индекс\nотпечатков" as fp_db
  }
  component "Модерация" as moderation {
    database "PostgreSQL" as moderation_db
  }
  database "Объектное хранилище\nS3 (Ceph)" as s3
}

package "Просмотр" as p_view {
  [Воспроизведение] as playback
  component "Поиск" as search {
    database "OpenSearch" as search_index
  }
  component "Лента и\nрекомендации" as feed {
    database "Redis:\nпризнаки" as feed_store
  }
  component "Реклама" as ads {
    database "ClickHouse" as ads_db
  }
}

package "Взаимодействие" as p_social {
  component "Реакции" as reactions {
    database "PostgreSQL" as reactions_db
  }
  component "Комментарии" as comments {
    database "PostgreSQL\n(шарды по видео)" as comments_db
  }
}

package "Деньги и аналитика" as p_money {
  component "Статистика\nи антифрод" as stats {
    database "ClickHouse" as stats_db
  }
  component "Товары" as goods {
    database "PostgreSQL" as goods_db
  }
  [Подписка\n«Премиум»] as premium
  component "Начисления\nи выплаты" as payouts {
    database "PostgreSQL\n(изолированная)" as payouts_db
  }
}

queue "Шина событий\nApache Kafka" as bus

package "Внешние системы" as external {
  [SMS-шлюз] as sms
  [Банк] as bank
  [Эквайринг] as acquiring
  [Рекламные\nсистемы] as adnet
  [Оператор\nрекламных данных] as ord
  [Маркетплейсы] as marketplaces
}

api -[hidden]right- hls
gw -[hidden]right- cdn
p_accounts -[hidden]right- p_content
p_content -[hidden]right- p_view
p_social -[hidden]right- p_money
p_money -[hidden]right- bus
p_accounts -[hidden]down- p_social
p_content -[hidden]down- p_money
sms -[hidden]right- bank
bank -[hidden]right- acquiring
acquiring -[hidden]right- adnet
adnet -[hidden]right- ord
ord -[hidden]right- marketplaces

gw ..> p_accounts
gw ..> p_content
gw ..> p_view
gw ..> p_social
gw ..> p_money

upload ..> s3
transcode ..> s3
cdn ..> s3
playback ..> catalog
playback ..> ads
feed ..> catalog
moderation ..> rights

p_accounts ..> bus
p_content ..> bus
p_view ..> bus
p_social ..> bus
p_money ..> bus

notify ..> sms
payouts ..> bank
premium ..> acquiring
ads ..> adnet
ads ..> ord
catalog ..> ord
goods ..> marketplaces

note bottom of bus
  Основные события: video.uploaded, video.processed,
  video.published, video.deleted, playback.heartbeat,
  short.viewed, ad.impression, goods.click,
  reaction.changed, comment.created
end note
@enduml
