@startuml components
title Видеохостинг «Ракурс»: диаграмма компонентов

skinparam componentStyle uml2
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam packageStyle rectangle
skinparam linetype polyline
skinparam nodesep 60
skinparam ranksep 55

package "Клиентские приложения" as clients {
  [Веб-приложение\n(просмотр и студия автора)] as web
  [Мобильные приложения\niOS, Android] as mobile
  [Приложение Smart TV] as tv
  [Рабочее место\nмодератора] as modui
}

() "REST API" as api
() "HLS / DASH" as hls
[API-шлюз] as gw
[CDN] as cdn
api -down- gw
hls -down- cdn
clients ..> api
clients ..> hls

package "Аккаунты" as p_accounts {
  component "Учётные записи" as auth {
    database "PostgreSQL" as auth_db
    database "Redis" as auth_cache
  }
  component "Уведомления" as notify {
    database "PostgreSQL" as notify_db
  }
}

package "Контент" as p_content {
  [Загрузка] as upload
  [Обработка видео] as transcode
  component "Каталог видео\nи каналов" as catalog {
    database "PostgreSQL" as catalog_db
  }
  component "Модерация" as moderation {
    database "PostgreSQL" as moderation_db
  }
  database "Объектное хранилище\nS3 (Ceph)" as s3
}

package "Просмотр" as p_view {
  component "Воспроизведение" as playback {
    database "Redis" as playback_cache
  }
  component "Поиск" as search {
    database "OpenSearch" as search_index
  }
  component "Реклама" as ads {
    database "ClickHouse" as ads_db
  }
}

package "Взаимодействие" as p_social {
  component "Реакции" as reactions {
    database "PostgreSQL" as reactions_db
    database "Redis" as reactions_cache
  }
  component "Комментарии" as comments {
    database "PostgreSQL" as comments_db
  }
}

package "Аналитика и выплаты" as p_money {
  component "Статистика" as stats {
    database "ClickHouse" as stats_db
  }
  component "Монетизация\nи выплаты" as payouts {
    database "PostgreSQL" as payouts_db
  }
}

[Шина событий\nApache Kafka] as bus
() "События" as events
bus -up- events

package "Внешние системы" as external {
  [SMS-шлюз] as sms
  [Банк-партнёр] as bank
  [Рекламные системы] as adnet
}

api -[hidden]right-> hls
gw -[hidden]right-> cdn
sms -[hidden]right- bank
bank -[hidden]right- adnet

gw ..> p_accounts
gw ..> p_content
gw ..> p_view
gw ..> p_social
gw ..> p_money

auth ..> notify
upload ..> s3
transcode ..> s3
cdn ..> s3
playback ..> catalog
playback ..> ads

p_accounts ..> events
p_content ..> events
p_view ..> events
p_social ..> events
p_money ..> events

notify ..> sms
payouts ..> bank
ads ..> adnet

@enduml
