<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_upload" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_upload">
    <bpmn:participant id="Participant_rakurs" name="Загрузка и публикация видео на видеохостинге «Ракурс»" processRef="Process_upload" />
  </bpmn:collaboration>
  <bpmn:process id="Process_upload" isExecutable="false">
    <bpmn:laneSet id="LaneSet_upload">
      <bpmn:lane id="Lane_owner" name="Владелец видео">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SelectFile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Metadata</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Settings</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Submit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndPublished</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndRejected</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_platform" name="Платформа (автоматически)">
        <bpmn:flowNodeRef>CheckFile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FileOk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Upload</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Transcode</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AutoCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CheckResult</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Approved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Scheduled</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Timer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Publish</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Reject</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_moderator" name="Модератор">
        <bpmn:flowNodeRef>ManualCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Decision</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Автор готов опубликовать видео">
      <bpmn:outgoing>f01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="SelectFile" name="Выбрать видеофайл в студии">
      <bpmn:incoming>f01</bpmn:incoming>
      <bpmn:incoming>f04</bpmn:incoming>
      <bpmn:outgoing>f02</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="CheckFile" name="Проверить формат, размер и длительность файла">
      <bpmn:incoming>f02</bpmn:incoming>
      <bpmn:outgoing>f03</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="FileOk" name="Файл подходит?">
      <bpmn:incoming>f03</bpmn:incoming>
      <bpmn:outgoing>f04</bpmn:outgoing>
      <bpmn:outgoing>f05</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="Split">
      <bpmn:incoming>f05</bpmn:incoming>
      <bpmn:outgoing>f06</bpmn:outgoing>
      <bpmn:outgoing>f07</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="Metadata" name="Ввести название и описание">
      <bpmn:incoming>f06</bpmn:incoming>
      <bpmn:outgoing>f08</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Settings" name="Выбрать обложку, доступ и время публикации">
      <bpmn:incoming>f08</bpmn:incoming>
      <bpmn:outgoing>f09</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Upload" name="Принять файл с докачкой при обрыве связи">
      <bpmn:incoming>f07</bpmn:incoming>
      <bpmn:outgoing>f10</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="d01">
        <bpmn:targetRef>Storage</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:task id="Transcode" name="Перекодировать в набор качеств, подготовить кадры для обложки">
      <bpmn:incoming>f10</bpmn:incoming>
      <bpmn:outgoing>f11</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="d02">
        <bpmn:targetRef>Storage</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:dataStoreReference id="Storage" name="Хранилище видео" />
    <bpmn:parallelGateway id="Join">
      <bpmn:incoming>f09</bpmn:incoming>
      <bpmn:incoming>f11</bpmn:incoming>
      <bpmn:outgoing>f12</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="Submit" name="Отправить видео на публикацию">
      <bpmn:incoming>f12</bpmn:incoming>
      <bpmn:outgoing>f13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="AutoCheck" name="Автоматически проверить видео, название и описание">
      <bpmn:incoming>f13</bpmn:incoming>
      <bpmn:outgoing>f14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="CheckResult" name="Есть признаки нарушений?">
      <bpmn:incoming>f14</bpmn:incoming>
      <bpmn:outgoing>f15</bpmn:outgoing>
      <bpmn:outgoing>f16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="ManualCheck" name="Проверить видео вручную">
      <bpmn:incoming>f16</bpmn:incoming>
      <bpmn:outgoing>f17</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Decision" name="Нарушение подтверждено?">
      <bpmn:incoming>f17</bpmn:incoming>
      <bpmn:outgoing>f18</bpmn:outgoing>
      <bpmn:outgoing>f19</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Approved">
      <bpmn:incoming>f15</bpmn:incoming>
      <bpmn:incoming>f18</bpmn:incoming>
      <bpmn:outgoing>f20</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Scheduled" name="Назначено время публикации?">
      <bpmn:incoming>f20</bpmn:incoming>
      <bpmn:outgoing>f21</bpmn:outgoing>
      <bpmn:outgoing>f22</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="Timer" name="Наступило время публикации">
      <bpmn:incoming>f22</bpmn:incoming>
      <bpmn:outgoing>f23</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDefinition" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="Publish" name="Опубликовать видео и уведомить подписчиков">
      <bpmn:incoming>f21</bpmn:incoming>
      <bpmn:incoming>f23</bpmn:incoming>
      <bpmn:outgoing>f24</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Reject" name="Отклонить публикацию и сообщить автору причину">
      <bpmn:incoming>f19</bpmn:incoming>
      <bpmn:outgoing>f25</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndPublished" name="Видео опубликовано">
      <bpmn:incoming>f24</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndRejected" name="Публикация отклонена">
      <bpmn:incoming>f25</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f01" sourceRef="Start" targetRef="SelectFile" />
    <bpmn:sequenceFlow id="f02" sourceRef="SelectFile" targetRef="CheckFile" />
    <bpmn:sequenceFlow id="f03" sourceRef="CheckFile" targetRef="FileOk" />
    <bpmn:sequenceFlow id="f04" name="нет" sourceRef="FileOk" targetRef="SelectFile" />
    <bpmn:sequenceFlow id="f05" name="да" sourceRef="FileOk" targetRef="Split" />
    <bpmn:sequenceFlow id="f06" sourceRef="Split" targetRef="Metadata" />
    <bpmn:sequenceFlow id="f07" sourceRef="Split" targetRef="Upload" />
    <bpmn:sequenceFlow id="f08" sourceRef="Metadata" targetRef="Settings" />
    <bpmn:sequenceFlow id="f09" sourceRef="Settings" targetRef="Join" />
    <bpmn:sequenceFlow id="f10" sourceRef="Upload" targetRef="Transcode" />
    <bpmn:sequenceFlow id="f11" sourceRef="Transcode" targetRef="Join" />
    <bpmn:sequenceFlow id="f12" sourceRef="Join" targetRef="Submit" />
    <bpmn:sequenceFlow id="f13" sourceRef="Submit" targetRef="AutoCheck" />
    <bpmn:sequenceFlow id="f14" sourceRef="AutoCheck" targetRef="CheckResult" />
    <bpmn:sequenceFlow id="f15" name="нет" sourceRef="CheckResult" targetRef="Approved" />
    <bpmn:sequenceFlow id="f16" name="да" sourceRef="CheckResult" targetRef="ManualCheck" />
    <bpmn:sequenceFlow id="f17" sourceRef="ManualCheck" targetRef="Decision" />
    <bpmn:sequenceFlow id="f18" name="нет" sourceRef="Decision" targetRef="Approved" />
    <bpmn:sequenceFlow id="f19" name="да" sourceRef="Decision" targetRef="Reject" />
    <bpmn:sequenceFlow id="f20" sourceRef="Approved" targetRef="Scheduled" />
    <bpmn:sequenceFlow id="f21" name="нет" sourceRef="Scheduled" targetRef="Publish" />
    <bpmn:sequenceFlow id="f22" name="да" sourceRef="Scheduled" targetRef="Timer" />
    <bpmn:sequenceFlow id="f23" sourceRef="Timer" targetRef="Publish" />
    <bpmn:sequenceFlow id="f24" sourceRef="Publish" targetRef="EndPublished" />
    <bpmn:sequenceFlow id="f25" sourceRef="Reject" targetRef="EndRejected" />
  </bpmn:process>
