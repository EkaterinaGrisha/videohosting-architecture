<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_upload" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_upload">
    <bpmn:participant id="Participant_rakurs" name="Загрузка и публикация видео на «Ракурсе»" processRef="Process_upload" />
    <bpmn:participant id="Participant_subscribers" name="Подписчики канала" />
    <bpmn:participant id="Participant_ord" name="Оператор рекламных данных (ЕРИР)" />
    <bpmn:messageFlow id="m1" name="push и письмо о новом видео" sourceRef="Notify" targetRef="Participant_subscribers" />
    <bpmn:messageFlow id="m2" name="данные о рекламе, если указан erid" sourceRef="Publish" targetRef="Participant_ord" />
  </bpmn:collaboration>
  <bpmn:process id="Process_upload" isExecutable="false">
    <bpmn:laneSet id="LaneSet_upload">
      <bpmn:lane id="Lane_owner" name="Владелец видео">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SelectFile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Metadata</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Settings</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>HasGoods</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Goods</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>HasGoodsJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Submit</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_platform" name="Платформа (автоматически)">
        <bpmn:flowNodeRef>CheckFile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FileOk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Upload</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Transcode</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IsShort</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>MarkShort</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IsShortJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Fingerprint</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AutoCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CheckResult</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Claim</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Approved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Scheduled</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Timer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ScheduledJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Publish</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Notify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndPublished</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndAborted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndBroken</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UploadTimeout</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TranscodeError</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_moderator" name="Модератор">
        <bpmn:flowNodeRef>Manual</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Confirmed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndRejected</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Автор решил опубликовать видео">
      <bpmn:outgoing>f01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="SelectFile" name="Выбрать файл в студии">
      <bpmn:incoming>f01</bpmn:incoming>
      <bpmn:incoming>f04</bpmn:incoming>
      <bpmn:outgoing>f02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="CheckFile" name="Проверить формат, размер и длительность">
      <bpmn:incoming>f02</bpmn:incoming>
      <bpmn:outgoing>f03</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="FileOk" name="Файл подходит?">
      <bpmn:incoming>f03</bpmn:incoming>
      <bpmn:outgoing>f04</bpmn:outgoing>
      <bpmn:outgoing>f05</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="Split">
      <bpmn:incoming>f05</bpmn:incoming>
      <bpmn:outgoing>f06</bpmn:outgoing>
      <bpmn:outgoing>f07</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="Upload" name="Принять файл с докачкой после обрыва">
      <bpmn:incoming>f06</bpmn:incoming>
      <bpmn:outgoing>f08</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOut_Upload"><bpmn:targetRef>Storage</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Transcode" name="Перекодировать: сначала 720p, затем остальные качества">
      <bpmn:incoming>f08</bpmn:incoming>
      <bpmn:outgoing>f09</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOut_Transcode"><bpmn:targetRef>Storage</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="IsShort" name="Вертикальное и не длиннее 3 минут?">
      <bpmn:incoming>f09</bpmn:incoming>
      <bpmn:outgoing>f10</bpmn:outgoing>
      <bpmn:outgoing>f11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="MarkShort" name="Добавить в ленту коротких видео">
      <bpmn:incoming>f10</bpmn:incoming>
      <bpmn:outgoing>f12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="IsShortJoin">
      <bpmn:incoming>f11</bpmn:incoming>
      <bpmn:incoming>f12</bpmn:incoming>
      <bpmn:outgoing>f13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Fingerprint" name="Сравнить с отпечатками правообладателей">
      <bpmn:incoming>f13</bpmn:incoming>
      <bpmn:outgoing>f14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Metadata" name="Ввести название и описание">
      <bpmn:incoming>f07</bpmn:incoming>
      <bpmn:outgoing>f15</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Settings" name="Выбрать обложку, доступ и время публикации">
      <bpmn:incoming>f15</bpmn:incoming>
      <bpmn:outgoing>f16</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="HasGoods" name="Есть товары или платная реклама?">
      <bpmn:incoming>f16</bpmn:incoming>
      <bpmn:outgoing>f17</bpmn:outgoing>
      <bpmn:outgoing>f18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Goods" name="Отметить товары и рекламу (токен erid)">
      <bpmn:incoming>f17</bpmn:incoming>
      <bpmn:outgoing>f19</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="HasGoodsJoin">
      <bpmn:incoming>f18</bpmn:incoming>
      <bpmn:incoming>f19</bpmn:incoming>
      <bpmn:outgoing>f20</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="Join">
      <bpmn:incoming>f14</bpmn:incoming>
      <bpmn:incoming>f20</bpmn:incoming>
      <bpmn:outgoing>f21</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="Submit" name="Отправить видео на публикацию">
      <bpmn:incoming>f21</bpmn:incoming>
      <bpmn:outgoing>f22</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="AutoCheck" name="Автоматически проверить видео, текст и товары">
      <bpmn:incoming>f22</bpmn:incoming>
      <bpmn:outgoing>f23</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="CheckResult" name="Результат проверки?">
      <bpmn:incoming>f23</bpmn:incoming>
      <bpmn:outgoing>f24</bpmn:outgoing>
      <bpmn:outgoing>f25</bpmn:outgoing>
      <bpmn:outgoing>f26</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Claim" name="Передать доход правообладателю, уведомить автора">
      <bpmn:incoming>f25</bpmn:incoming>
      <bpmn:outgoing>f27</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Manual" name="Проверить видео вручную (не дольше 2 часов)">
      <bpmn:incoming>f26</bpmn:incoming>
      <bpmn:outgoing>f28</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Confirmed" name="Нарушение подтверждено?">
      <bpmn:incoming>f28</bpmn:incoming>
      <bpmn:outgoing>f29</bpmn:outgoing>
      <bpmn:outgoing>f30</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Reject" name="Отклонить и указать причину">
      <bpmn:incoming>f30</bpmn:incoming>
      <bpmn:outgoing>f31</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EndRejected" name="Публикация отклонена">
      <bpmn:incoming>f31</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Approved">
      <bpmn:incoming>f24</bpmn:incoming>
      <bpmn:incoming>f27</bpmn:incoming>
      <bpmn:incoming>f29</bpmn:incoming>
      <bpmn:outgoing>f32</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Scheduled" name="Назначено время публикации?">
      <bpmn:incoming>f32</bpmn:incoming>
      <bpmn:outgoing>f33</bpmn:outgoing>
      <bpmn:outgoing>f34</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="Timer" name="Наступило время публикации">
      <bpmn:incoming>f33</bpmn:incoming>
      <bpmn:outgoing>f35</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_publish" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="ScheduledJoin">
      <bpmn:incoming>f34</bpmn:incoming>
      <bpmn:incoming>f35</bpmn:incoming>
      <bpmn:outgoing>f36</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Publish" name="Опубликовать: канал, поиск, лента, рекомендации">
      <bpmn:incoming>f36</bpmn:incoming>
      <bpmn:outgoing>f37</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="Notify" name="Уведомить подписчиков">
      <bpmn:incoming>f37</bpmn:incoming>
      <bpmn:outgoing>f38</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="EndPublished" name="Видео опубликовано">
      <bpmn:incoming>f38</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndAborted" name="Загрузка прервана">
      <bpmn:incoming>f39</bpmn:incoming>
      <bpmn:terminateEventDefinition id="Term_aborted" />
    </bpmn:endEvent>
    <bpmn:endEvent id="EndBroken" name="Ошибка обработки, автор получает причину">
      <bpmn:incoming>f40</bpmn:incoming>
      <bpmn:terminateEventDefinition id="Term_broken" />
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="UploadTimeout" name="24 часа без докачки" attachedToRef="Upload">
      <bpmn:outgoing>f39</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_upload" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="TranscodeError" name="Файл повреждён" attachedToRef="Transcode">
      <bpmn:outgoing>f40</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorDef_transcode" />
    </bpmn:boundaryEvent>
    <bpmn:dataStoreReference id="Storage" name="Хранилище видео" />
    <bpmn:sequenceFlow id="f01" sourceRef="Start" targetRef="SelectFile" />
    <bpmn:sequenceFlow id="f02" sourceRef="SelectFile" targetRef="CheckFile" />
    <bpmn:sequenceFlow id="f03" sourceRef="CheckFile" targetRef="FileOk" />
    <bpmn:sequenceFlow id="f04" name="нет: показать причину" sourceRef="FileOk" targetRef="SelectFile" />
    <bpmn:sequenceFlow id="f05" name="да" sourceRef="FileOk" targetRef="Split" />
    <bpmn:sequenceFlow id="f06" sourceRef="Split" targetRef="Upload" />
    <bpmn:sequenceFlow id="f07" sourceRef="Split" targetRef="Metadata" />
    <bpmn:sequenceFlow id="f08" sourceRef="Upload" targetRef="Transcode" />
    <bpmn:sequenceFlow id="f09" sourceRef="Transcode" targetRef="IsShort" />
    <bpmn:sequenceFlow id="f10" name="да" sourceRef="IsShort" targetRef="MarkShort" />
    <bpmn:sequenceFlow id="f11" name="нет" sourceRef="IsShort" targetRef="IsShortJoin" />
    <bpmn:sequenceFlow id="f12" sourceRef="MarkShort" targetRef="IsShortJoin" />
    <bpmn:sequenceFlow id="f13" sourceRef="IsShortJoin" targetRef="Fingerprint" />
    <bpmn:sequenceFlow id="f14" sourceRef="Fingerprint" targetRef="Join" />
    <bpmn:sequenceFlow id="f15" sourceRef="Metadata" targetRef="Settings" />
    <bpmn:sequenceFlow id="f16" sourceRef="Settings" targetRef="HasGoods" />
    <bpmn:sequenceFlow id="f17" name="да" sourceRef="HasGoods" targetRef="Goods" />
    <bpmn:sequenceFlow id="f18" name="нет" sourceRef="HasGoods" targetRef="HasGoodsJoin" />
    <bpmn:sequenceFlow id="f19" sourceRef="Goods" targetRef="HasGoodsJoin" />
    <bpmn:sequenceFlow id="f20" sourceRef="HasGoodsJoin" targetRef="Join" />
    <bpmn:sequenceFlow id="f21" sourceRef="Join" targetRef="Submit" />
    <bpmn:sequenceFlow id="f22" sourceRef="Submit" targetRef="AutoCheck" />
    <bpmn:sequenceFlow id="f23" sourceRef="AutoCheck" targetRef="CheckResult" />
    <bpmn:sequenceFlow id="f24" name="нарушений нет" sourceRef="CheckResult" targetRef="Approved" />
    <bpmn:sequenceFlow id="f25" name="совпадение с чужим видео" sourceRef="CheckResult" targetRef="Claim" />
    <bpmn:sequenceFlow id="f26" name="признаки нарушения" sourceRef="CheckResult" targetRef="Manual" />
    <bpmn:sequenceFlow id="f27" sourceRef="Claim" targetRef="Approved" />
    <bpmn:sequenceFlow id="f28" sourceRef="Manual" targetRef="Confirmed" />
    <bpmn:sequenceFlow id="f29" name="нет" sourceRef="Confirmed" targetRef="Approved" />
    <bpmn:sequenceFlow id="f30" name="да" sourceRef="Confirmed" targetRef="Reject" />
    <bpmn:sequenceFlow id="f31" sourceRef="Reject" targetRef="EndRejected" />
    <bpmn:sequenceFlow id="f32" sourceRef="Approved" targetRef="Scheduled" />
    <bpmn:sequenceFlow id="f33" name="да" sourceRef="Scheduled" targetRef="Timer" />
    <bpmn:sequenceFlow id="f34" name="нет" sourceRef="Scheduled" targetRef="ScheduledJoin" />
    <bpmn:sequenceFlow id="f35" sourceRef="Timer" targetRef="ScheduledJoin" />
    <bpmn:sequenceFlow id="f36" sourceRef="ScheduledJoin" targetRef="Publish" />
    <bpmn:sequenceFlow id="f37" sourceRef="Publish" targetRef="Notify" />
    <bpmn:sequenceFlow id="f38" sourceRef="Notify" targetRef="EndPublished" />
    <bpmn:sequenceFlow id="f39" sourceRef="UploadTimeout" targetRef="EndAborted" />
    <bpmn:sequenceFlow id="f40" sourceRef="TranscodeError" targetRef="EndBroken" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_upload">
    <bpmndi:BPMNPlane id="Plane_upload" bpmnElement="Collaboration_upload">
      <bpmndi:BPMNShape id="Participant_rakurs_di" bpmnElement="Participant_rakurs" isHorizontal="true"><dc:Bounds x="100" y="60" width="4675.2" height="750" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_owner_di" bpmnElement="Lane_owner" isHorizontal="true"><dc:Bounds x="130" y="60" width="4645.2" height="250" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_platform_di" bpmnElement="Lane_platform" isHorizontal="true"><dc:Bounds x="130" y="310" width="4645.2" height="360" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_moderator_di" bpmnElement="Lane_moderator" isHorizontal="true"><dc:Bounds x="130" y="670" width="4645.2" height="140" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Participant_subscribers_di" bpmnElement="Participant_subscribers" isHorizontal="true"><dc:Bounds x="4261.2" y="900" width="340" height="60" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Participant_ord_di" bpmnElement="Participant_ord" isHorizontal="true"><dc:Bounds x="3710.7999999999997" y="900" width="340" height="60" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_di" bpmnElement="Start"><dc:Bounds x="354" y="222" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="317" y="262" width="110" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SelectFile_di" bpmnElement="SelectFile"><dc:Bounds x="469" y="197" width="150" height="86" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="CheckFile_di" bpmnElement="CheckFile"><dc:Bounds x="641" y="447" width="150" height="86" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="FileOk_di" bpmnElement="FileOk" isMarkerVisible="true"><dc:Bounds x="863" y="465" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="833" y="521" width="110" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Split_di" bpmnElement="Split"><dc:Bounds x="1035" y="465" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Upload_di" bpmnElement="Upload"><dc:Bounds x="1157" y="447" width="150" height="86" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Transcode_di" bpmnElement="Transcode"><dc:Bounds x="1381" y="447" width="150" height="86" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="IsShort_di" bpmnElement="IsShort" isMarkerVisible="true"><dc:Bounds x="1654" y="465" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="1624" y="521" width="110" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="MarkShort_di" bpmnElement="MarkShort"><dc:Bounds x="1793" y="337" width="150" height="86" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="IsShortJoin_di" bpmnElement="IsShortJoin" isMarkerVisible="true"><dc:Bounds x="2033" y="465" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Fingerprint_di" bpmnElement="Fingerprint"><dc:Bounds x="2172" y="447" width="150" height="86" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Metadata_di" bpmnElement="Metadata"><dc:Bounds x="1157" y="197" width="150" height="86" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Settings_di" bpmnElement="Settings"><dc:Bounds x="1381" y="197" width="150" height="86" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="HasGoods_di" bpmnElement="HasGoods" isMarkerVisible="true"><dc:Bounds x="1654" y="215" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="1624" y="271" width="110" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Goods_di" bpmnElement="Goods"><dc:Bounds x="1793" y="87" width="150" height="86" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="HasGoodsJoin_di" bpmnElement="HasGoodsJoin" isMarkerVisible="true"><dc:Bounds x="2033" y="215" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Join_di" bpmnElement="Join"><dc:Bounds x="2411" y="215" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Submit_di" bpmnElement="Submit"><dc:Bounds x="2533" y="197" width="150" height="86" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="AutoCheck_di" bpmnElement="AutoCheck"><dc:Bounds x="2739" y="447" width="150" height="86" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="CheckResult_di" bpmnElement="CheckResult" isMarkerVisible="true"><dc:Bounds x="2996" y="465" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="2966" y="521" width="110" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Claim_di" bpmnElement="Claim"><dc:Bounds x="3152" y="337" width="150" height="86" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Manual_di" bpmnElement="Manual"><dc:Bounds x="3152" y="697" width="150" height="86" />
